# Calepin artifacts: results, figures, and metadata for each document.
.calepin/

# Build output — regenerated by CI (calepin compile . _site) on every deploy.
_site/

# Generated Typst entry files, written beside each source document while it
# renders. A build removes its own; strays are left by interrupted runs and
# swept up by `calepin clean`.
.calepin-entry.*
.DS_Store
